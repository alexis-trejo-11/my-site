// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Portfolio project workspace document.
/// Nested shapes from app/projects/models/project.ts are stored as Json
/// (SQLite has no native arrays/enums/relations for those trees).
model Project {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  /// Domain: "backend" | "frontend" | "infra" | "fullstack"
  type    String
  tagline String
  /// Domain: "active" | "wip" | "archived"
  status  String?

  /// string[] in TypeScript
  tags Json

  /// { description, features }
  overview Json?

  /// { description?, why?, diagram?, decisions? }
  architecture Json?

  /// { pipeline? }
  infra Json?

  /// { category, items }[]
  stack Json?

  /// nested Project[] (microservices) — keep as Json for now
  services Json?

  /// TODO: tighten when apiExplorer shape is defined
  apiExplorer Json?

  /// Link[] — Resources panel
  links Json?

  /// { title, date, tag? }[] — Recent Changes panel
  recentChanges Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
