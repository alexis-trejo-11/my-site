# Generated at container start from ALLOWED_HOSTS (see docker/entrypoint.sh).
# HTTPS and reverse proxy stay on Cloudflare — this process only serves HTTP.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  server_tokens off;

  # Unknown Host → close (Host header allowlist via server_name below).
  server {
    listen 4000 default_server;
    server_name _;
    return 444;
  }

  server {
    listen 4000;
    server_name __SERVER_NAMES__;

    root /usr/share/nginx/html;
    index index.html;

    location ~* \.(?:js|css|woff2?|svg|png|jpe?g|gif|ico|webp|avif)$ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      try_files $uri =404;
    }

    # Angular SPA client-side routes
    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
